{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "proectio",
  "main": "src/worker.ts",
  "compatibility_date": "2026-09-22",
  "assets": {
    "directory": "./dist",
    "binding": "ASSETS",
    "not_found_handling": "single-page-application"
  },
  "vars": {
    "GITHUB_APP_ID": "5062093",
    "GITHUB_CLIENT_ID": "Iv23lignlZc2qFlBadPp",
    "OWNER_LOGIN": "sergii"
  },
  "secrets": {
    "required": [
      "GITHUB_PRIVATE_KEY",
      "GITHUB_CLIENT_SECRET",
      "SESSION_SECRET"
    ]
  }
}
